{
  "name": "universal-tcg-ai",
  "version": "0.1.0",
  "description": "A game-agnostic engine and MCTS AI that can play any turn-based card game (TCG).",
  "type": "module",
  "scripts": {
    "play": "tsx src/cli.ts",
    "web": "npm run web:build && tsx src/server.ts",
    "web:dev": "cd web && npm run dev",
    "web:build": "cd web && npm run build",
    "start": "node launcher.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "tcg",
    "mcts",
    "ismcts",
    "game-ai",
    "card-game"
  ],
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  }
}
