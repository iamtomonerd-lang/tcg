{
  "name": "universal-tcg-ai",
  "version": "0.1.0",
  "description": "A game-agnostic engine and MCTS AI that can play any turn-based card game (TCG).",
  "type": "module",
  "scripts": {
    "play": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "tcg",
    "mcts",
    "ismcts",
    "game-ai",
    "card-game"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
